# Benchmark results under examples/data are generated by a script and are kept
# in the repository only so the postprocessing notebook and tests can run
# without re-running the benchmarks.
#
# linguist-generated: exclude from language statistics and collapse in diffs.
# -diff: treat as binary so they report 0 insertions/deletions in diff stats.
examples/data/** linguist-generated=true
examples/data/**/*.csv -diff
